# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
**/dist/
**/build/

# Environment (auto-created from .env.example by npm start)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Temporary
*.tmp
.luminary-cache/

# Persisted app state (conversations, agent model assignments)
backend/data/

# Lumen's identity + curated memories — personal content, and the live
# files the app reads/writes. Kept out of git so sharing the code never
# ships someone's memories. Recreated automatically on first boot.
/Memory/

# Local GGUF model files (auto-created folder — models stay on disk, never in git)
models/*
!models/README.txt

# Private runtime state and local model weights, wherever created
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.gguf
*.safetensors
*.pem
*.key
.claude/
coverage/
