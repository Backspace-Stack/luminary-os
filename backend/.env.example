# ── Luminary OS Backend ───────────────────────────────────────
# Copy this file to .env (done automatically by npm start / run.sh / run.bat)

# Server
PORT=3001
NODE_ENV=development

# Host to bind the API server to — 127.0.0.1 (default) keeps it off the LAN; Docker Compose overrides this to 0.0.0.0 so the container is reachable
BIND_HOST=127.0.0.1

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# ── Future integrations (connect when ready) ──────────────────
OLLAMA_BASE_URL=http://localhost:11434
MQTT_BROKER_URL=mqtt://localhost:1883
VECTOR_DB_URL=http://localhost:6333

# ── Agent tool-use loop ───────────────────────────────────────
# Max model⇄tool round-trips before a loop aborts with an honest error.
AGENT_MAX_TOOL_ITERATIONS=15
# Total wall-clock budget (ms) for a single agent's tool loop.
# CPU-only inference needs a much higher value than GPU inference — this covers a full multi-step tool loop, not just one model call.
# Default 30 min (1800000): real observed speed here is ~1.9 tok/s (qwen3:8b). Hitting it returns partial progress, never discards it.
AGENT_TOOL_TIMEOUT_MS=1800000
# How many times a *transient* tool failure (network/timeout/upstream 5xx)
# is auto-retried before surfacing to the model. Validation/security
# failures are never retried. Retries do NOT consume loop iterations.
AGENT_TOOL_RETRY_LIMIT=2

# ── Terminal plugin (exec) ────────────────────────────────────
# Sandbox directory the exec tool is confined to (created on boot).
# Default: backend/data/sandbox. The command allow-list
# (ls, cat, pwd, echo, git) is hard-coded in the plugin. node/npm are
# deliberately excluded — an unsandboxed node process can read/write
# any path the backend can, bypassing FilePlugin's guards entirely.
TERMINAL_SANDBOX_DIR=./data/sandbox

# ── File plugin (read/write/list/delete/readFolderTree) ───────
# Sandbox root for filesystem access. Shares the terminal sandbox by
# default so files written here are visible to exec and vice-versa.
# write/delete pause for user approval (confirmation gate).
FILE_SANDBOX_DIR=./data/sandbox
# Additional REAL folders Lumen may read/list/tree and (with approval)
# write/delete in, alongside the sandbox. Separate multiple paths with
# ';' on Windows or ':' on macOS/Linux (newlines also work). The same
# lexical + symlink-escape protection as the sandbox applies to each
# root — a path outside every listed root is refused. Leave blank to
# stay sandbox-only. write/delete on these still require confirmation.
# Windows example:
# Add only folders you explicitly trust; separate Windows paths with semicolons.
# macOS/Linux example:
FILE_ALLOWED_DIRS=

# ── Tavily web search plugin ──────────────────────────────────
# API key for live web search (https://tavily.com). Without it, the
# search tool fails honestly (success:false) — it never fabricates
# results. Get a key at https://app.tavily.com.
TAVILY_API_KEY=

# ── API auth token (optional) ─────────────────────────────────
# When set, every /api route (except /api/health, which the launcher
# polls to detect readiness) requires "Authorization: Bearer <value>";
# anything missing or wrong gets a 401. Leave empty to keep the API
# open exactly as before. The UI reads VITE_API_AUTH_TOKEN or a runtime token.
# Live model notifications send the same bearer token in request headers.
API_AUTH_TOKEN=

# ── Discord bridge (chat-only) ────────────────────────────────
# Normally saved in Settings → Integrations (same store as Tavily);
# these env vars are fallbacks for headless setups. The bridge starts
# only when a bot token exists. DISCORD_ALLOWED_USER_ID is YOUR
# Discord user id — messages from anyone else are dropped before they
# ever reach a model.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_ID=

# ── Persistent memory (SQLite) ────────────────────────────────
# One DB file for long-term memories and paused tool confirmations.
# Default: backend/data/luminary.db.
DB_PATH=./data/luminary.db
# Ollama model used to embed memories and search queries. Pull it with
# `ollama pull nomic-embed-text`. If unavailable, memories are stored
# without vectors and semantic recall returns nothing (never faked).
EMBED_MODEL=nomic-embed-text

# ── Lumen identity & curated memories ─────────────────────────
# Both live in the "Memory" folder at the project root — the files you
# edit by hand ARE the files the app loads, and /remember writes to
# MEMORIES.md directly. Created from a starter if missing; never
# overwritten. Read-only to all agents/tools.
#
# Leave these UNSET (as below) so the built-in default applies: it is
# resolved from the code's own location, so it points at <project
# root>/Memory no matter which directory the process is started from.
# Only set them to relocate the files — the values are resolved
# relative to the backend's working directory, so prefer absolute paths.
# LUMEN_IDENTITY_PATH=
# LUMEN_MEMORIES_PATH=

# ── Memory maintenance ─────────────────────────────────────────
# How often (ms) to sweep expired memories and expired pending tool
# confirmations from the database. Default: 5 minutes.
EVICTION_INTERVAL_MS=300000
# Minimum cosine similarity (0-1) a memory must reach to be considered
# relevant. Applies to BOTH automatic working-memory injection and
# explicit recall() calls — below this floor, memory search returns
# nothing rather than padding with weak matches. 0.5 is a conservative
# default for nomic-embed-text: genuinely related text commonly scores
# ~0.55-0.8+ cosine similarity, unrelated/off-topic text commonly scores
# ~0.2-0.45, so 0.5 sits just above the "unrelated" band. Other embedding
# models may need a different value.
MEMORY_MIN_SIMILARITY=0.5
